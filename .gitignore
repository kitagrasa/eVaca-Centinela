# Secretos y datos locales
.env
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# El estado se versiona en state/state.json porque es la memoria del bot.
# Pero los datos volátiles de cada ejecución no interesan.
state/*.runtime.json
state/*.tmp
state/*.bak

# Claves SSH. La documentación (contexto.md, puesta en marcha) explica generarlas así:
#     ssh-keygen -t ed25519 -N "" -f ./clave_estado
# Si se generan dentro del repositorio y quedan aquí, un 'git add .' las
# publicaría: la clave privada da acceso de escritura al repositorio de estado,
# donde está la lista de personas y sus carteras.
clave_estado*
id_rsa*
id_ed25519*
*.pem
*.key

# Si usas un repositorio privado para el estado (ver contexto.md),
# el workflow clona ahí la carpeta .state-repo. No debe acabar en el repo.
.state-repo/
